{
  "name": "open-api-client",
  "version": "0.4.0",
  "private": true,
  "description": "Git-friendly OpenAPI collaboration client",
  "repository": "https://github.com/dohyeon-kr/free-rider",
  "author": "Ju Dohyeon",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac --publish never",
    "test:electron": "electron . --smoke-test"
  },
  "dependencies": {
    "quickjs-emscripten": "^0.32.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.dohyeon.openapi.client",
    "productName": "Free Rider",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "artifactName": "Free-Rider-${version}-mac-${arch}.${ext}"
  }
}
